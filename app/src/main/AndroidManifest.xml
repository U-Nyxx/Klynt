<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-update: launch package installer for the downloaded APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (Android 11+): without these, getPackageInfo /
         getApplicationInfo throw NameNotFoundException even for installed
         targets, leaving the Apps tab empty. Keep in sync with
         META-INF/xposed/scope.list. -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.beta" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.plus" />
        <package android:name="tw.nekomimi.nekogram" />
        <package android:name="org.nekogram" />
        <package android:name="nekox.messenger" />
        <package android:name="xyz.nextalone.nagram" />
        <package android:name="nu.gpu.nagram" />
        <package android:name="nu.gpu.nagramx" />
        <package android:name="uz.unnarsx.cherrygram" />
        <package android:name="org.forkgram.messenger" />
        <package android:name="org.forkclient.messenger" />
        <package android:name="org.telegram.group" />
        <package android:name="it.octogram.android" />
        <package android:name="it.belloworld.mercurygram" />
        <package android:name="top.qwq2333.nullgram" />
        <package android:name="com.iMe.android" />
        <package android:name="com.exteragram.messenger" />
        <package android:name="telega.messenger" />
        <package android:name="com.yukigram" />
        <package android:name="app.nicegram" />
        <package android:name="com.tgconnect.android" />
        <package android:name="org.forkgram.classic" />
        <package android:name="fork.risin42.nagramx" />
        <package android:name="com.iMe.android.web" />
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:name=".KlyntApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Klynt">

        <activity
            android:name=".manager.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>